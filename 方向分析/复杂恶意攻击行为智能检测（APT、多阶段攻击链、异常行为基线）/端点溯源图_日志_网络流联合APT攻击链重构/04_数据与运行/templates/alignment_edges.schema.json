{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "strong-truth-alignment-edges-v0.1",
  "title": "Strong-Truth cross-source alignment edge",
  "type": "object",
  "required": [
    "edge_id", "run_id", "src_record", "dst_record",
    "relation_type", "label", "evidence", "annotator_ids"
  ],
  "properties": {
    "edge_id": {"type": "string"},
    "run_id": {"type": "string"},
    "src_record": {"type": "string"},
    "dst_record": {"type": "string"},
    "relation_type": {
      "enum": [
        "flow_of_socket", "socket_of_process", "auth_of_session",
        "session_of_process", "alert_explains_event",
        "same_entity", "corroborates", "other"
      ]
    },
    "label": {"enum": ["exact", "ambiguous", "heuristic", "unmatched"]},
    "candidate_set_id": {"type": ["string", "null"]},
    "alternative_dst_records": {"type": "array", "items": {"type": "string"}},
    "evidence": {
      "type": "object",
      "properties": {
        "identity": {"type": "array", "items": {"type": "string"}},
        "temporal": {"type": "array", "items": {"type": "string"}},
        "behavioral": {"type": "array", "items": {"type": "string"}},
        "conflicts": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "annotator_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "adjudication": {"type": ["string", "null"]},
    "notes": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
