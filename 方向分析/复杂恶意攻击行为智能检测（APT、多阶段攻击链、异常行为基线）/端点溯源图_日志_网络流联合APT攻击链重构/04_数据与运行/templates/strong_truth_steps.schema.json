{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "strong-truth-steps-v0.1",
  "title": "Strong-Truth attack step",
  "type": "object",
  "required": [
    "attack_id", "run_id", "step_id", "technique_id",
    "start_time_utc", "end_time_utc", "source_host",
    "target_host", "expected_predecessor_ids",
    "expected_successor_ids", "orchestrator_record",
    "sensor_health_ref"
  ],
  "properties": {
    "attack_id": {"type": "string"},
    "run_id": {"type": "string"},
    "step_id": {"type": "string"},
    "stage_id": {"type": ["string", "null"]},
    "technique_id": {"type": "string", "pattern": "^T[0-9]{4}(\\.[0-9]{3})?$"},
    "start_time_utc": {"type": "string", "format": "date-time"},
    "end_time_utc": {"type": "string", "format": "date-time"},
    "source_host": {"type": ["string", "null"]},
    "target_host": {"type": ["string", "null"]},
    "account": {"type": ["string", "null"]},
    "session_id": {"type": ["string", "null"]},
    "process_guid": {"type": ["string", "null"]},
    "pid": {"type": ["integer", "string", "null"]},
    "parent_process_guid": {"type": ["string", "null"]},
    "executable": {"type": ["string", "null"]},
    "command_hash": {"type": ["string", "null"]},
    "artifact": {"type": ["string", "null"]},
    "src_ip": {"type": ["string", "null"]},
    "src_port": {"type": ["integer", "null"], "minimum": 0, "maximum": 65535},
    "dst_ip": {"type": ["string", "null"]},
    "dst_port": {"type": ["integer", "null"], "minimum": 0, "maximum": 65535},
    "protocol": {"type": ["string", "null"]},
    "expected_predecessor_ids": {"type": "array", "items": {"type": "string"}},
    "expected_successor_ids": {"type": "array", "items": {"type": "string"}},
    "orchestrator_record": {"type": "string"},
    "operator_record": {"type": ["string", "null"]},
    "sensor_health_ref": {"type": "string"},
    "clock_offset_ns": {"type": ["integer", "null"]},
    "status": {"enum": ["success", "failed", "partial", "unknown"]},
    "notes": {"type": ["string", "null"]}
  },
  "additionalProperties": true
}
