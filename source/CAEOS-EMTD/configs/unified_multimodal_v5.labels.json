{
  "schema_version": "caeos_label_source_registry_v1",
  "frozen_at": "2026-08-02",
  "rules": {
    "path_labels_are_auxiliary_unless_capture_is_documented_single_class": true,
    "flow_level_mixed_capture_requires_five_tuple_time_join": true,
    "timezone_must_be_inferred_or_declared_per_dataset": true,
    "unmatched_or_conflicting_rows_are_not_admitted": true,
    "required_output_labels": [
      "traffic_class",
      "binary_label",
      "attack_category",
      "attack_subcategory",
      "fine_label",
      "family_label"
    ],
    "required_audit_fields": [
      "label_source_sha256",
      "total_output_flows",
      "matched_flows",
      "unmatched_flows",
      "conflicting_flows",
      "path_csv_disagreements",
      "coverage_fraction"
    ]
  },
  "datasets": {
    "ciciot2023": {
      "authority": "documented_single_attack_capture_directory",
      "sources": [
        "/opt/data/private/wangwt/ParkAttackKE/datasets/cic/CIC_IOT_Dataset2023/CIC_IOT_Dataset2023_PCAP/CSV/CSV/**/*.pcap.csv",
        "/opt/data/private/wangwt/ParkAttackKE/datasets/cic/CIC_IOT_Dataset2023/CIC_IOT_Dataset2023_PCAP/CSV/MERGED_CSV/*.csv"
      ],
      "join_mode": "capture_relative_path_with_merged_label_crosscheck",
      "status": "adapter_and_coverage_audit_required"
    },
    "ciciot2022": {
      "authority": "official_experiment_and_archive_member_taxonomy",
      "sources": [
        "/opt/data/private/wangwt/ParkAttackKE/datasets/cic/CIC_IOT_Dataset2022/Readme.txt",
        "/opt/data/private/wangwt/ParkAttackKE/datasets/cic/CIC_IOT_Dataset2022/5-Active/Readme.txt",
        "/opt/data/private/wangwt/ParkAttackKE/datasets/cic/CIC_IOT_Dataset2022/*.tar.gz"
      ],
      "join_mode": "capture_or_archive_member_path_with_readme_taxonomy",
      "status": "archive_readme_and_member_coverage_audit_required"
    },
    "edge_iiotset": {
      "authority": "paired_packet_csv_attack_columns",
      "sources": [
        "/opt/data/private/wangwt/ParkAttackKE/datasets/cic/EdgeIIoT/Edge-IIoTset dataset/**/*.csv"
      ],
      "identity_columns": ["frame.time", "ip.src_host", "ip.dst_host"],
      "label_columns": ["Attack_label", "Attack_type"],
      "join_mode": "paired_capture_packet_csv_then_flow_consensus",
      "status": "adapter_and_conflict_audit_required"
    },
    "cicids2017": {
      "authority": "generated_labelled_flow_csv",
      "sources": [
        "/opt/data/private/wangwt/ParkAttackKE/datasets/cic/cic_cicids2017/derived/GeneratedLabelledFlows/*.csv"
      ],
      "identity_columns": [
        "Source IP",
        "Source Port",
        "Destination IP",
        "Destination Port",
        "Protocol",
        "Timestamp",
        "Flow Duration"
      ],
      "label_columns": ["Label"],
      "join_mode": "canonical_bidirectional_five_tuple_time_interval_per_day",
      "timezone_policy": "infer_per_pcap_with_afternoon_clock_correction",
      "status": "existing_join_logic_requires_v5_adapter"
    },
    "cicids2018": {
      "authority": "official_attack_schedule_endpoint_and_time_rules",
      "sources": [
        "/opt/data/private/wangwt/ParkAttackKE/datasets/cic/cic_cse_cic_ids2018/raw/Processed Traffic Data for ML Algorithms/*.csv",
        "https://www.unb.ca/cic/datasets/ids-2018.html#attack-schedule"
      ],
      "identity_columns": ["source_ip", "destination_ip", "timestamp"],
      "label_columns": ["Label"],
      "join_mode": "official_endpoint_pair_and_attack_time_window_with_benign_fallback",
      "timezone_policy": "America/New_York",
      "status": "schedule_adapter_and_regenerated_full_capture_audit_required"
    },
    "cic_bot_iot": {
      "authority": "official_ground_truth_csv",
      "sources": [
        "/opt/data/private/wangwt/ParkAttackKE/datasets/cic/CIC-BoT-IoT/Ground Truth/*.csv",
        "/opt/data/private/wangwt/ParkAttackKE/datasets/cic/CIC-BoT-IoT/CIC-BoT-IoT.zip::*/data/CIC-BoT-IoT.csv"
      ],
      "identity_columns": ["stime", "ltime", "proto", "saddr", "sport", "daddr", "dport"],
      "label_columns": ["attack", "category", "subcategory"],
      "join_mode": "canonical_bidirectional_five_tuple_epoch_interval",
      "status": "adapter_and_path_conflict_audit_required"
    },
    "cic_ton_iot": {
      "authority": "official_security_event_ground_truth",
      "sources": [
        "/opt/data/private/wangwt/ParkAttackKE/datasets/cic/CIC-ToN-IoT/SecuityEvents_GroundTruth_datasets/SecurityEvents_Network_datasets/GroundTruth_Network_*.csv",
        "/opt/data/private/wangwt/ParkAttackKE/datasets/cic/CIC-ToN-IoT/Processed_datasets/Processed_Network_dataset/Network_dataset_*.csv"
      ],
      "identity_columns": ["ts", "src_ip", "src_port", "dst_ip", "dst_port", "proto"],
      "label_columns": ["label", "type"],
      "join_mode": "canonical_bidirectional_five_tuple_epoch_event_interval",
      "status": "adapter_and_security_event_coverage_audit_required"
    },
    "cicddos2019": {
      "authority": "official_cicflowmeter_csv_archives",
      "sources": [
        "/opt/data/private/wangwt/ParkAttackKE/datasets/cic/CICDDoS2019/CSVs/CSV-01-12.zip",
        "/opt/data/private/wangwt/ParkAttackKE/datasets/cic/CICDDoS2019/CSVs/CSV-03-11.zip"
      ],
      "identity_columns": [
        "Source IP",
        "Source Port",
        "Destination IP",
        "Destination Port",
        "Protocol",
        "Timestamp",
        "Flow Duration"
      ],
      "label_columns": ["Label"],
      "join_mode": "canonical_bidirectional_five_tuple_time_interval_day_and_attack_csv",
      "status": "adapter_and_extensionless_pcap_time_mapping_required"
    },
    "dohbrw2020": {
      "authority": "paired_flow_csv",
      "sources": [
        "/opt/data/private/wangwt/ParkAttackKE/datasets/cic/DoHBrw2020/CSVs/**/*.csv"
      ],
      "identity_columns": [
        "SourceIP",
        "SourcePort",
        "DestinationIP",
        "DestinationPort",
        "TimeStamp",
        "Duration"
      ],
      "label_columns": ["DoH", "Label"],
      "join_mode": "paired_member_canonical_five_tuple_time_interval",
      "status": "adapter_and_duplicate_csv_precedence_audit_required"
    },
    "unsw_nb15": {
      "authority": "official_ground_truth_csv",
      "sources": [
        "/opt/data/private/wangwt/ParkAttackKE/datasets/UNSW-NB15/CSVs/CSV Files/*.csv"
      ],
      "identity_columns": ["srcip", "sport", "dstip", "dsport", "proto", "stime", "ltime"],
      "label_columns": ["Label", "attack_cat"],
      "join_mode": "canonical_bidirectional_five_tuple_epoch_interval",
      "status": "strict_full_pcap_alignment_completed"
    },
    "5gad_2022": {
      "authority": "documented_single_class_capture_path",
      "sources": [
        "/opt/data/private/wangwt/ParkAttackKE/datasets/5GAD-2022/repository/README.md",
        "/opt/data/private/wangwt/ParkAttackKE/datasets/5GAD-2022/repository/Normal-2UE/*.pcapng",
        "/opt/data/private/wangwt/ParkAttackKE/datasets/5GAD-2022/repository/Attacks/*/Attacks_*.pcapng"
      ],
      "join_mode": "capture_relative_path_with_readme_taxonomy",
      "status": "full_capture_alignment_completed"
    },
    "iscx_tor_nontor_2017": {
      "authority": "official_scenario_csv_and_archive_member_taxonomy",
      "sources": [
        "/opt/data/private/wangwt/ParkAttackKE/datasets/cic/iscx_tor_nontor_2017/raw/CSVs/Scenario-A-merged_5s.csv",
        "/opt/data/private/wangwt/ParkAttackKE/datasets/cic/iscx_tor_nontor_2017/raw/CSVs/Scenario-B-merged_5s.csv"
      ],
      "identity_columns": [
        "Source IP",
        "Source Port",
        "Destination IP",
        "Destination Port",
        "Protocol"
      ],
      "label_columns": ["label"],
      "join_mode": "five_tuple_multiset_and_archive_member_label_crosscheck",
      "status": "adapter_requires_no_timestamp_ambiguity_audit"
    },
    "iscx_vpn_nonvpn_2016": {
      "authority": "archive_member_application_and_vpn_taxonomy",
      "sources": [
        "/opt/data/private/wangwt/ParkAttackKE/datasets/cic/iscx_vpn_nonvpn_2016/raw/PCAPs/*.zip"
      ],
      "join_mode": "archive_member_path",
      "status": "blocked_no_local_flow_label_csv_or_log_found"
    },
    "parrot2025": {
      "authority": "paired_pcap_and_tls_key_log_application_capture",
      "sources": [
        "/opt/data/private/wangwt/ParkAttackKE/datasets/PARROT2025_mitmproxy/*.pcap",
        "/opt/data/private/wangwt/ParkAttackKE/datasets/PARROT2025_mitmproxy/sslkeylog_*.txt"
      ],
      "join_mode": "filename_application_timestamp_pair",
      "fixed_binary_role": "benign_safety_only",
      "status": "pairing_coverage_audit_required"
    },
    "crossplatform_android_ios": {
      "authority": "MApps_flow_file_path_and_jsonl_class_metadata",
      "sources": [
        "/opt/data/private/wangwt/ParkAttackKE/datasets/CrossPlatform/Datasets/CrossPlatform_android/**/*.jsonl",
        "/opt/data/private/wangwt/ParkAttackKE/datasets/CrossPlatform/Datasets/CrossPlatform_ios/**/*.jsonl"
      ],
      "identity_columns": ["sample_relpath", "sample_id"],
      "label_columns": ["class", "split"],
      "join_mode": "pcap_relative_path_to_jsonl_sample_relpath",
      "fixed_binary_role": "benign_application_shift_only",
      "status": "deduplication_and_pairing_coverage_audit_required"
    }
  }
}
