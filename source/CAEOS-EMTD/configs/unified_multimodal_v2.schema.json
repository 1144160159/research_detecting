{
  "schema_version": "caeos_unified_multimodal_csv_schema_v2",
  "row_unit": "bidirectional_flow_segment",
  "flow_key": "canonical_bidirectional_ip_port_protocol_five_tuple",
  "flow_idle_timeout_seconds": 30.0,
  "maximum_packets_stored": 64,
  "payload_prefix_bytes": 4096,
  "sanitized_l4_prefix_bytes": 2048,
  "payload_encoding": "base64",
  "sequence_encoding": "semicolon_separated_decimal",
  "raw_mac_or_ip_addresses_stored": false,
  "ports_stored": true,
  "columns": [
    {"name": "schema_version", "type": "string"},
    {"name": "dataset_id", "type": "string"},
    {"name": "dataset_role", "type": "string"},
    {"name": "sample_id", "type": "sha256_hex"},
    {"name": "capture_id", "type": "string"},
    {"name": "source_container_sha256", "type": "sha256_hex"},
    {"name": "source_member", "type": "string"},
    {"name": "label_status", "type": "string"},
    {"name": "label_source", "type": "string"},
    {"name": "label_mapping_version", "type": "string"},
    {"name": "dataset_native_label", "type": "string"},
    {"name": "traffic_class", "type": "string", "values": ["Benign", "Malicious", "Pending"]},
    {"name": "attack_category", "type": "string", "values": ["Benign", "DDoS", "DoS", "Reconnaissance", "Brute_Force", "Spoofing_MITM", "Botnet_Malware", "DNS_Tunneling", "Web_Attack", "Other_Attack", "Pending"]},
    {"name": "attack_subcategory", "type": "string"},
    {"name": "fine_label", "type": "string"},
    {"name": "family_label", "type": "string"},
    {"name": "binary_label", "type": "int8", "values": [-1, 0, 1]},
    {"name": "flow_segment_index", "type": "uint32"},
    {"name": "flow_key_hash", "type": "sha256_hex"},
    {"name": "flow_start_ns", "type": "int64"},
    {"name": "flow_end_ns", "type": "int64"},
    {"name": "duration_us", "type": "uint64"},
    {"name": "ip_version", "type": "uint8"},
    {"name": "transport_protocol", "type": "uint8"},
    {"name": "endpoint_a_hash", "type": "hex64"},
    {"name": "endpoint_b_hash", "type": "hex64"},
    {"name": "port_a", "type": "uint16"},
    {"name": "port_b", "type": "uint16"},
    {"name": "packet_count_total", "type": "uint32"},
    {"name": "packet_count_stored", "type": "uint8"},
    {"name": "forward_packet_count", "type": "uint32"},
    {"name": "reverse_packet_count", "type": "uint32"},
    {"name": "packet_bytes_total", "type": "uint64"},
    {"name": "forward_packet_bytes", "type": "uint64"},
    {"name": "reverse_packet_bytes", "type": "uint64"},
    {"name": "payload_bytes_total", "type": "uint64"},
    {"name": "forward_payload_bytes", "type": "uint64"},
    {"name": "reverse_payload_bytes", "type": "uint64"},
    {"name": "packet_length_min", "type": "uint16"},
    {"name": "packet_length_max", "type": "uint16"},
    {"name": "packet_length_mean", "type": "float64"},
    {"name": "packet_length_std", "type": "float64"},
    {"name": "packet_iat_us_min", "type": "uint32"},
    {"name": "packet_iat_us_max", "type": "uint32"},
    {"name": "packet_iat_us_mean", "type": "float64"},
    {"name": "packet_iat_us_std", "type": "float64"},
    {"name": "packet_payload_length_min", "type": "uint16"},
    {"name": "packet_payload_length_max", "type": "uint16"},
    {"name": "packet_payload_length_mean", "type": "float64"},
    {"name": "packet_payload_length_std", "type": "float64"},
    {"name": "packets_per_second", "type": "float64"},
    {"name": "bytes_per_second", "type": "float64"},
    {"name": "payload_bytes_stored", "type": "uint16"},
    {"name": "payload_b64", "type": "base64"},
    {"name": "sanitized_l4_bytes_total", "type": "uint64"},
    {"name": "sanitized_l4_bytes_stored", "type": "uint16"},
    {"name": "sanitized_l4_b64", "type": "base64"},
    {"name": "packet_length_seq", "type": "uint16_sequence"},
    {"name": "ip_length_seq", "type": "uint16_sequence"},
    {"name": "packet_iat_us_seq", "type": "uint32_sequence"},
    {"name": "direction_seq", "type": "int8_sequence"},
    {"name": "packet_protocol_seq", "type": "uint8_sequence"},
    {"name": "tcp_flags_seq", "type": "uint8_sequence"},
    {"name": "ip_dscp_ecn_seq", "type": "uint8_sequence"},
    {"name": "ip_flags_seq", "type": "uint8_sequence"},
    {"name": "ip_fragment_offset_seq", "type": "uint16_sequence"},
    {"name": "transport_header_length_seq", "type": "uint8_sequence"},
    {"name": "tcp_sequence_seq", "type": "uint32_sequence"},
    {"name": "tcp_acknowledgement_seq", "type": "uint32_sequence"},
    {"name": "packet_payload_length_seq", "type": "uint16_sequence"},
    {"name": "sanitized_l4_packet_length_seq", "type": "uint16_sequence"},
    {"name": "packet_ttl_seq", "type": "uint8_sequence"},
    {"name": "tcp_window_seq", "type": "uint16_sequence"},
    {"name": "application_protocol_hint", "type": "string"},
    {"name": "tls_record_type_seq", "type": "uint8_sequence"},
    {"name": "tls_record_version_seq", "type": "uint16_sequence"},
    {"name": "tls_record_length_seq", "type": "uint16_sequence"},
    {"name": "tls_handshake_type_seq", "type": "uint8_sequence"},
    {"name": "tls_client_hello_present", "type": "uint8"},
    {"name": "tls_server_hello_present", "type": "uint8"},
    {"name": "quic_long_header_packet_count", "type": "uint8"},
    {"name": "quic_version_seq", "type": "uint32_sequence"},
    {"name": "payload_histogram", "type": "uint32_sequence_256"}
  ],
  "final_csv_label_contract": {
    "traffic_class_values": ["Benign", "Malicious"],
    "binary_label_values": [0, 1],
    "attack_category_required": true,
    "attack_subcategory_required": true,
    "pending_labels_allowed_only_in_internal_parts": true
  },
  "claim_boundary": {
    "payload_is_transport_layer_bytes_without_decryption": true,
    "sanitized_l4_zeroes_transport_checksum_and_excludes_ip_addresses": true,
    "packet_graph_is_derived_later_from_packet_and_endpoint_primitives": true,
    "tls_and_quic_columns_are_protocol_hints_not_ground_truth_labels": true,
    "new_features_outside_this_frozen_reservoir_require_a_new_dataset_version": true
  }
}
