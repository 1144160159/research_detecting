    "traffic_class",
    "attack_category",
    "attack_subcategory",
    "fine_label",
    "family_label",
    "binary_label"
  ],
  "default_forbidden_model_features": [
    "dataset_id",
    "dataset_role",
    "sample_id",
    "capture_id",
    "source_container_sha256",
    "source_member",
    "label_status",
