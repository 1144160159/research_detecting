  "dataset_policies": {
    "ciciot2023": "all_three_modalities_primary_development",
    "ciciot2022": "all_three_modalities_external_iot_confirmation_and_benign_safety",
    "edge_iiotset": "all_three_modalities_external_protocol_heterogeneity_confirmation",
    "cicids2017": "behavior_primary_payload_and_graph_secondary_classic_external",
    "cic_bot_iot": "behavior_and_payload_primary_graph_secondary_botnet_ddos_external",
    "cic_ton_iot": "payload_and_behavior_primary_graph_secondary_heterogeneous_external",
    "cicddos2019": "behavior_primary_graph_secondary_payload_ablation_only_ddos_specialist",
    "dohbrw2020": "encrypted_protocol_structure_and_behavior_primary_payload_distribution_secondary_doh_specialist",
    "iscx_tor_nontor_2017": "behavior_primary_payload_ablation_only_benign_domain_shift",
    "iscx_vpn_nonvpn_2016": "blocked_until_label_adapter_passes",
    "parrot2025": "benign_safety_only_no_attack_training_or_threshold_selection",
    "crossplatform_android_ios": "benign_application_shift_only_no_attack_training_or_threshold_selection"
  },
  "selection_gate": {
    "fit_scope": "training_and_known_only_validation",
    "unknown_test_features_or_labels_visible_during_selection": false,
    "required_grouping": [
      "capture_or_fingerprint_grouped_split",
      "payload_prefix_hash_duplicate_audit",
      "packet_sequence_hash_duplicate_audit"
    ],
    "required_ablations": [
      "each_single_modality",
      "each_modality_pair",
      "all_three_modalities",
      "safe_features_vs_port_enabled_diagnostic",
      "payload_byte_order_shuffle",
      "packet_time_permutation",
      "graph_edge_permutation",
      "encrypted_protocol_structure_on_off",
      "modality_dropout"
    ],
    "report_separately": [
      "within_dataset_known_classification",
      "within_dataset_unknown_rejection",
      "cross_dataset_unknown_rejection",
      "benign_domain_shift_false_alarm"
    ]
  }
}
