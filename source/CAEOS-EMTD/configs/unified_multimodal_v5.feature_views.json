      "forbidden_node_or_edge_sources": [
        "endpoint_a_hash",
        "endpoint_b_hash",
        "port_a",
        "port_b",
        "capture_id",
        "source_member"
      ],
      "default_packet_count": 16,
      "selection_candidates": [8, 16, 32, 64]
    }
