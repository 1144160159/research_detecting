{
  "schema_version": "caeos_unified_multimodal_csv_schema_v1",
  "row_unit": "bidirectional_flow_segment",
  "flow_key": "canonical_bidirectional_ip_port_protocol_five_tuple",
  "flow_idle_timeout_seconds": 30.0,
  "maximum_packets_stored": 64,
  "payload_prefix_bytes": 4096,
  "payload_encoding": "base64",
  "sequence_encoding": "semicolon_separated_decimal",
  "raw_mac_or_ip_addresses_stored": false,
  "ports_stored": true,
  "columns": [
    {"name": "schema_version", "type": "string"},
    {"name": "dataset_id", "type": "string"},
    {"name": "dataset_role", "type": "string"},
    {"name": "sample_id", "type": "sha256_hex"},
    {"name": "capture_id", "type": "string"},
    {"name": "source_container_sha256", "type": "sha256_hex"},
    {"name": "source_member", "type": "string"},
    {"name": "label_status", "type": "string"},
    {"name": "fine_label", "type": "string"},
    {"name": "family_label", "type": "string"},
    {"name": "binary_label", "type": "int8", "values": [-1, 0, 1]},
    {"name": "flow_segment_index", "type": "uint32"},
    {"name": "flow_key_hash", "type": "sha256_hex"},
    {"name": "flow_start_ns", "type": "int64"},
    {"name": "flow_end_ns", "type": "int64"},
    {"name": "duration_us", "type": "uint64"},
    {"name": "ip_version", "type": "uint8"},
    {"name": "transport_protocol", "type": "uint8"},
    {"name": "endpoint_a_hash", "type": "hex64"},
    {"name": "endpoint_b_hash", "type": "hex64"},
    {"name": "port_a", "type": "uint16"},
    {"name": "port_b", "type": "uint16"},
    {"name": "packet_count_total", "type": "uint32"},
    {"name": "packet_count_stored", "type": "uint8"},
    {"name": "payload_bytes_total", "type": "uint64"},
    {"name": "payload_bytes_stored", "type": "uint16"},
    {"name": "payload_b64", "type": "base64"},
    {"name": "packet_length_seq", "type": "uint16_sequence"},
    {"name": "packet_iat_us_seq", "type": "uint32_sequence"},
    {"name": "direction_seq", "type": "int8_sequence"},
    {"name": "packet_protocol_seq", "type": "uint8_sequence"},
    {"name": "tcp_flags_seq", "type": "uint8_sequence"},
    {"name": "packet_payload_length_seq", "type": "uint16_sequence"},
    {"name": "packet_ttl_seq", "type": "uint8_sequence"},
    {"name": "tcp_window_seq", "type": "uint16_sequence"},
    {"name": "payload_histogram", "type": "uint32_sequence_256"}
  ],
  "claim_boundary": {
    "payload_is_transport_layer_bytes_without_decryption": true,
    "payload_prefix_and_full_flow_histogram_are_reusable_features": true,
    "packet_graph_is_derived_later_from_packet_and_endpoint_primitives": true,
    "new_features_outside_this_frozen_reservoir_require_a_new_dataset_version": true
  }
}
