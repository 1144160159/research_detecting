{
  "schema_version": "tao_stage1_adapter_pilot_v1",
  "status": "frozen_before_real_results",
  "upstream": {
    "repository": "https://github.com/WaIdo/TAO-NET",
    "commit": "a1574f38741772ac79628131f9fbef8a7c78374a",
    "component": "stage1_ood_detection",
    "upstream_backbone": "RoBERTa",
    "upstream_default_threshold": "test ID plus test OOD Youden J"
  },
  "adapter": {
    "backbone": "strict-v2 shared two-layer MLP",
    "blood": "50-estimator Hutchinson inter-layer Jacobian smoothness",
    "pca_variance_ratio": 0.95,
    "pca_fit_split": "known_only_train",
    "normalization_split": "known_only_validation",
    "fusion": "0.6 * PCA residual z-score + 0.4 * BLOOD z-score",
    "threshold_split": "known_only_validation",
    "known_acceptance": 0.95,
    "unknown_or_test_labels_used_for_fitting_or_selection": false,
    "protocol_class": "paper_code_adapter_not_original_method_reproduction"
  },
  "pilot": [
    {"suite": "edge_iiot", "scenario": "fingerprinting", "seed": 7},
    {"suite": "nf_cse", "scenario": "bot", "seed": 7},
    {"suite": "ustc_tfc2016", "scenario": "geodo", "seed": 7}
  ],
  "decision_rule": {
    "expand_only_if": "adapter completes without leakage and mean AUROC plus mean OSCR are not both below the strongest same-run MLP postprocessor",
    "otherwise": "retain as a secondary negative adapter result"
  }
}
