{
  "schema_version": "caeos_minimal_open_set_repro_v1",
  "description": "Two-dataset, one-unknown-family, three-risk-profile reproduction.",
  "shared": {
    "split_strategy": "fingerprint_grouped",
    "known_acceptance": 0.95,
    "global_max_features": "0.5",
    "jobs": 8
  },
  "modes": {
    "smoke": {
      "seeds": [7],
      "estimators": 20,
      "scientific_evidence": false
    },
    "paper": {
      "seeds": [7, 19, 31],
      "estimators": 200,
      "scientific_evidence": true
    }
  },
  "datasets": {
    "mal_tls_tor": {
      "csv_argument": "mal_csv",
      "config": "configs/mal_tls2023.json",
      "unknown_classes": "Tor_None_TLS_CC",
      "benign_class": "benign",
      "max_per_class": {
        "smoke": 100,
        "paper": 300
      }
    },
    "hikari_probing": {
      "csv_argument": "hikari_csv",
      "config": "configs/hikari2021.json",
      "unknown_classes": "Probing",
      "benign_class": "Benign",
      "max_per_class": {
        "smoke": 100,
        "paper": 2000
      }
    }
  },
  "risk_profiles": {
    "support_union": {
      "risk_selection": "fixed_named",
      "fixed_risk_name": "support_union"
    },
    "cauchy_evidence": {
      "risk_selection": "fixed_named",
      "fixed_risk_name": "cauchy_evidence"
    },
    "nested_conflict_gate": {
      "risk_selection": "nested_conflict_gate"
    }
  },
  "required_outputs": [
    "metrics.json",
    "scores.npz",
    "evidence_package.npz"
  ],
  "claim_boundary": {
    "smoke": "Execution and artifact-integrity check only.",
    "paper": "A focused profile experiment; not comprehensive-SOTA evidence by itself."
  }
}
