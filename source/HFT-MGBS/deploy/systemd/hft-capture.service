[Unit]
Description=HFT-MGBS Rust physical capture data plane
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/hft-mgbs/capture.env
WorkingDirectory=/home/wangwt/phase_2/code/HFT-MGBS
ExecStart=/home/wangwt/phase_2/code/HFT-MGBS/rust/hft-capture/target/release/hft-capture --interface ${HFT_CAPTURE_INTERFACE} --driver ${HFT_CAPTURE_DRIVER} --gpu-endpoint listen://0.0.0.0:50052 --gpu-startup-wait-ms 10000 --gpu-timeout-ms 150 --metrics /home/wangwt/task/datasets/replay/live/metrics.json --batch-size 128 --feature-flush-us 1000 --budget-us 5000 --execution-budget-safety-ratio 0.50
Restart=on-failure
RestartSec=2
LimitNOFILE=1048576
AmbientCapabilities=CAP_NET_RAW CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_ADMIN
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
